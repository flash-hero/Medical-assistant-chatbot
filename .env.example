# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Gemini (server-side only; never expose to the browser) ---
# Use GEMINI_API_KEY only. Do NOT also set GOOGLE_API_KEY: the SDK prefers it when both exist.
GEMINI_API_KEY=
# free | paid. While "free", only synthetic data may be sent to the API and paid-only models are disabled.
GEMINI_TIER=free

# --- Runtime ---
AUSCULTA_ENV=dev
# Demo flag: stays true until the P7 pilot checklist is signed (docs/intended-purpose.md).
AUSCULTA_DEMO_MODE=true
AUSCULTA_DATA_ROOT=C:/dev/ausculta-data
# Session-token signing secret (generate: python -c "import secrets; print(secrets.token_urlsafe(48))")
AUSCULTA_SESSION_SECRET=

# --- Services ---
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
DATABASE_URL=sqlite+aiosqlite:///C:/dev/ausculta-data/ausculta.db
REDIS_URL=

# --- Spend guard (USD) ---
AUSCULTA_DAILY_SPEND_CAP_USD=5
AUSCULTA_KILL_SWITCH=false
