        }
      },
      "required": [
        "id",
        "question",
        "answer"
      ],
      "title": "FAQ",
      "type": "object"
    },
    "L10n": {
      "additionalProperties": false,
      "description": "Localised string. English is mandatory; missing FR/AR fall back to English with a flag in the UI.",
      "properties": {
        "en": {
          "minLength": 1,
          "title": "En",
          "type": "string"
        },
        "fr": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fr"
        },
        "ar": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ar"
        }
      },
      "required": [
        "en"
      ],
      "title": "L10n",
      "type": "object"
    },
    "PhoneContact": {
