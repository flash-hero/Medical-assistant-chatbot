    "lighthouse": "node scripts/measure/lighthouse.mjs",
    "measure:metrics": "node scripts/measure/ui-metrics.mjs",
    "contrast": "node scripts/check-contrast.mjs",
    "brand": "node scripts/brand/build-brand.mjs",
    "icons": "node scripts/icons/build-icons.mjs",
    "sync:attribution": "node scripts/content/sync-attribution.mjs"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/readex-pro": "5.3.0",
    "gsap": "3.15.1",
    "lenis": "1.3.27",
    "next": "16.4.6",
