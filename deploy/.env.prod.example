# Production secrets for deploy/compose.yaml. Copy to deploy/.env.prod (gitignored) and fill every value.
SITE_ADDRESS=ausculta.example.org
GEMINI_API_KEY=
GEMINI_TIER=paid
AUSCULTA_DEMO_MODE=true
AUSCULTA_SESSION_SECRET=
AUSCULTA_ALLOWED_ORIGINS=https://ausculta.example.org
AUSCULTA_DAILY_SPEND_CAP_USD=20
AUSCULTA_KILL_SWITCH=false
AUSCULTA_HOSPITAL_PROFILE=/srv/config/hospital/demo.yaml
POSTGRES_PASSWORD=
REDIS_PASSWORD=
QDRANT_API_KEY=
WEB_CONCURRENCY=1
# Embeddings: local (default, EmbeddingGemma in the image), gemini (paid API), never fake in prod
AUSCULTA_EMBED_BACKEND=local
