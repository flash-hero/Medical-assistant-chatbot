# The container's only port. The hosting platform (Modal, or a Hugging Face Space) terminates TLS and is the
# only way in, so its proxy is trusted: it appends the client address to X-Forwarded-For, Caddy appends the
# proxy's, and the API (AUSCULTA_TRUSTED_PROXY_COUNT=2) rate-limits the entry the platform appended.
{
	admin off
	servers {
		trusted_proxies static 0.0.0.0/0 ::/0
		timeouts {
			read_header 10s
			read_body 30s
			idle 2m
		}
	}
}

:7860 {
	encode {
		zstd
		gzip
		# never compress SSE (it would buffer the stream)
		match {
			header Content-Type text/html*
			header Content-Type text/css*
			header Content-Type application/javascript*
			header Content-Type application/json*
			header Content-Type image/svg+xml*
		}
	}

	request_body {
		max_size 64KB
	}

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		-Server
	}

	route {
		# Operational endpoints are for internal checks only, not the internet.
		@internal path /api/v1/ready /api/v1/meta
		respond @internal 404

		handle /api/* {
			reverse_proxy 127.0.0.1:8000 {
				flush_interval -1
				transport http {
					read_timeout 120s
				}
			}
		}

		handle {
			reverse_proxy 127.0.0.1:3000
		}
	}

	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri regexp \?.*$ ""
				request>headers>Authorization delete
				request>headers>Cookie delete
			}
		}
	}
}
