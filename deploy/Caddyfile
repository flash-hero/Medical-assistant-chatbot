# Single origin: /api/* -> FastAPI, everything else -> Next.js.
# SITE_ADDRESS: a domain for automatic HTTPS (e.g. ausculta.example.org) or ":80" for local testing.
{
	servers {
		timeouts {
			read_header 10s
			read_body 30s
			idle 2m
		}
	}
}

# SITE_ADDRESS must be the public domain (automatic HTTPS). Use ":80" only for local testing (review S19).
{$SITE_ADDRESS} {
	encode {
		zstd
		gzip
		# never compress SSE (it would buffer the stream)
		match {
			header Content-Type text/html*
			header Content-Type text/css*
			header Content-Type application/javascript*
			header Content-Type application/json*
			header Content-Type image/svg+xml*
		}
	}

	request_body {
		max_size 64KB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		-Server
	}

	# `route` keeps the literal order below (Caddy otherwise runs `handle` before `respond`).
	route {
		# Operational endpoints are for the internal health checks only, not the internet (review S10).
		@internal path /api/v1/ready /api/v1/meta
		respond @internal 404

		handle /api/* {
			reverse_proxy api:8000 {
				# stream SSE immediately; keep long-lived connections open
				flush_interval -1
				transport http {
					read_timeout 120s
				}
				# The API trusts exactly one proxy hop (AUSCULTA_TRUSTED_PROXY_COUNT=1). Caddy sets
				# X-Forwarded-For from the client address and ignores client-supplied values.
			}
		}

		handle {
			reverse_proxy web:3000
		}
	}

	log {
		output stdout
		# JSON access log without query strings, credentials or bodies (they may contain health information)
		format filter {
			wrap json
			fields {
				request>uri regexp \?.*$ ""
				request>headers>Authorization delete
				request>headers>Cookie delete
			}
		}
	}
}
